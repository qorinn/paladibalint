---
const { description, expandLabel, collapseLabel } = Astro.props as {
  description: string
  expandLabel: string
  collapseLabel: string
}
---

<details class="group mt-3">
  <summary
    class="w-fit cursor-pointer text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/30 focus-visible:outline-none"
  >
    <span class="group-open:hidden">{expandLabel}</span>
    <span class="hidden group-open:inline">{collapseLabel}</span>
  </summary>
  <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
</details>
