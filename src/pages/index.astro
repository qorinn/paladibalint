---
import Layout from "@/layouts/main.astro"
import { getPageContent } from "@/lib/cms"
import Footer from "@/components/link-hub/Footer.astro"
import ProfileHeader from "@/components/link-hub/ProfileHeader.astro"
import Section from "@/components/link-hub/Section.astro"

const content = await getPageContent()
const { profile } = content
const socialProfiles = [
  ...new Set(
    content.sections
      .filter((section) => section.section_type === "social_links")
      .flatMap((section) => section.links)
      .map((link) => link.target_url)
      .filter((url) => /^https?:\/\//.test(url))
  ),
]
const schemaBaseUrl = Astro.site ?? Astro.url
const profileUrl = Astro.site ? new URL("/", Astro.site).toString() : undefined
const profileImage = profile.avatar_path
  ? new URL(profile.avatar_path, schemaBaseUrl).toString()
  : undefined
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": profileUrl ? `${profileUrl}#person` : undefined,
      name: profile.name,
      jobTitle: profile.position ?? undefined,
      description: profile.description ?? undefined,
      url: profileUrl,
      image: profileImage,
      sameAs: socialProfiles.length > 0 ? socialProfiles : undefined,
      knowsAbout: [
        "full-stack szoftverfejlesztés",
        "webfejlesztés",
        "webalkalmazás-fejlesztés",
      ],
    },
    {
      "@type": "WebSite",
      name: profile.name,
      url: profileUrl,
      inLanguage: "hu-HU",
      about: {
        "@type": "Person",
        name: profile.name,
      },
    },
  ],
}
---

<Layout
  title={profile.meta_title ?? profile.name}
  description={profile.meta_description}
  ogImage={profile.og_image_path}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <main
    class="mx-auto flex min-h-svh w-full max-w-2xl flex-col px-5 py-12 sm:px-8 sm:py-16"
  >
    <ProfileHeader profile={profile} />
    <div class="mt-12 flex flex-col gap-10">
      {
        content.sections.map((section) => (
          <Section section={section} profile={profile} />
        ))
      }
    </div>
    <div class="mt-auto pt-14"><Footer text={profile.footer_text} /></div>
  </main>
  <script>
    const params = new URLSearchParams(window.location.search)
    const payload = {
      pathname: window.location.pathname,
      referrer: document.referrer,
      utm_source: params.get("utm_source"),
      utm_medium: params.get("utm_medium"),
      utm_campaign: params.get("utm_campaign"),
      utm_content: params.get("utm_content"),
      utm_term: params.get("utm_term"),
    }

    fetch("/api/analytics/page-view", {
      method: "POST",
      credentials: "same-origin",
      keepalive: true,
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    }).catch(() => undefined)
  </script>
</Layout>
